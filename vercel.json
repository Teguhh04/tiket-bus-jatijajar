{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        },
        "api/dbcheck.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/dbcheck",
            "dest": "/api/dbcheck.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "COMPOSER_FLAGS": "--prefer-dist --optimize-autoloader --no-scripts",
        "VERCEL": "1",
        "APP_ENV": "production",
        "APP_KEY": "base64:nossjJAVYCaomEY02Gkd9agJQRktcutlFCHyK6YQKxo=",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_STACK": "stderr",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "120",
        "SESSION_ENCRYPT": "false",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "BROADCAST_CONNECTION": "log",
        "MAIL_MAILER": "log",
        "PAYMENT_BANK_NAME": "Bank BCA",
        "PAYMENT_ACCOUNT_NUMBER": "1234 5678 9012",
        "PAYMENT_ACCOUNT_NAME": "PT JATIJAJAR TIKET ONLINE",
        "PAYMENT_QRIS_IMAGE": "images/qris_rekening.png"
    }
}