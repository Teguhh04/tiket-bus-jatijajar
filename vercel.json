{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "COMPOSER_FLAGS": "--no-dev --prefer-dist --optimize-autoloader --no-scripts",
        "VERCEL": "1",
        "APP_ENV": "production",
        "APP_KEY": "base64:KdlkRgEPO+GV9Kp7CFF0xTVZlRHe0qCCrtv3bTOj6Ag=",
        "APP_DEBUG": "true",
        "LOG_CHANNEL": "stderr",
        "LOG_STACK": "stderr",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": ":memory:",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "MAIL_MAILER": "log"
    }
}
